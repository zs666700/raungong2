          "goal": "完成主视觉与文案，把报名量做到目标人数的 1.1 倍。",
          "key_actions": [
            "确定口号与主视觉",
            "公众号推文与班级群同步发布",
            "建立报名接龙并每日核对"
          ],
          "owner": "宣传组 · 陈默",
          "deliverables": [
            "主视觉与海报",
            "推文链接",
            "报名名单"
