  "patchRequestBody": {
    "version": 1,
    "data": {
      "summary": "面向120 位参与者，11 月 14 日在学校礼堂举办，预计 120 人参与，全程约 120 分钟。方案以轻松活泼的基调组织，覆盖场地设备、物料制作、宣传、餐饮与奖品，预算控制在 ¥3,600 以内。",
      "background": "新学期活动密集，120 位参与者对迎新晚会类活动的参与意愿较高，但筹备窗口通常只有两到三周。需要在有限预算内把流程、物料与人员安排一次性讲清楚，避免临场补位。",
      "objectives": [
        "让120 位参与者完整参与一次有记忆点的迎新晚会",
        "在 2026-11-14 前完成场地、物料与人员准备",
        "把总支出控制在 ¥3,600 以内",
        "沉淀一份可复用的活动流程与分工模板"
      ],
      "highlights": [
        "开场灯光秀与社团联合演出",
        "社团风采展示与全场互动游戏，设置至少 2 个可参与的互动点位",
        "现场抽取 4 份互动奖品",
        "用一块主视觉背景板串起签到、合影与传播素材"
      ],
      "success_criteria": [
        "实际到场率不低于 90%，签到人数达到 108 人",
        "现场无安全事故，设备故障在 10 分钟内恢复",
        "活动结束后 24 小时内完成图文复盘与费用对账"
      ],
      "phases": [
        {
          "id": "P1",
          "name": "立项与统筹",
          "start_date": "2026-10-24",
          "end_date": "2026-10-31",
          "goal": "把活动目标、预算上限与责任人定下来，完成场地与审批。",
          "key_actions": [
            "确认主题、规模与预算上限",
            "建立筹备群，明确五个小组负责人",
            "提交场地申请与活动审批"
          ],
          "owner": "统筹组 · 林晓",
          "deliverables": [
            "活动立项单",
            "分组分工表",
            "场地与审批回执"
          ]
        },
